!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# large design sources (local only)
/design/source/

# visual verification output
/playwright-report/
/test-results/
/screenshots/actual/
/screenshots/diff/

*.psb
/deliverables/

# QA artifacts stay local; track compact reports and required test fixtures only.
/screenshots/
/output/playwright/
/docs/evidence/**
!/docs/evidence/**/
!/docs/evidence/**/*.md
!/docs/evidence/**/*.json
!/docs/evidence/**/discipline-stage*.txt
!/docs/evidence/technology-viewer/live-title/mask-*.png
!/docs/evidence/technology-viewer/cybermind/mask-*.png
**/__pycache__/
*.py[cod]

# Raw process logs can contain private runtime metadata and credentials.
*.log

# Compact, reviewed certificate QA evidence
!/docs/evidence/certificates/*.png
!/docs/evidence/certificates/*.txt

