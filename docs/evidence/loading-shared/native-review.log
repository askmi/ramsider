      requested.current = 0;
      setGroupIndex(0);
      setPhotos([]);
      setIsOpen(true);
      dialogElement.showModal();
      dialogElement.focus({ preventScroll: true });
      select(0);
      technologyGroups.forEach(group => group.slides.forEach(slide => { void loadImage(slide.src).ready.catch(() => {}); }));
