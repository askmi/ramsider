   198	.media-loading p{margin:0 0 10px}
   199	.media-loading__track{height:4px;background:#d6d0c7;overflow:hidden;direction:ltr}
   200	.media-loading__bar{display:block;height:100%;background:#ac7e41}
   201	.media-loading__bar.is-indeterminate{width:35%;animation:media-progress 1.2s ease-in-out infinite}
