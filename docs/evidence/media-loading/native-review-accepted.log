docs/evidence/media-loading/native-review-final-delivery.log:62:| Shared loading status and progress | One loading-status component, shared resource readiness helpers and scroll-lock hook; real streamed byte progress for technology images, indeterminate native-page progress where browser byte counts are unavailable | Partial byte percentage when Content-Length exists; indeterminate fallback; accessible labels and retry |
    30	  const listeners = new Set<(progress: ImageProgress) => void>();
    31	  const resource: ImageResource = {
    32	    progress: { loaded: 0, total: null, ready: false, error: false },
    33	    ready: Promise.resolve(null as unknown as HTMLImageElement),
    34	    subscribe(listener) {
    35	      listeners.add(listener);
    36	      listener(resource.progress);
    37	      return () => { listeners.delete(listener); };
    38	    },
    39	  };
    40	  const update = (patch: Partial<ImageProgress>) => {
    41	    resource.progress = { ...resource.progress, ...patch };
    42	    listeners.forEach(listener => listener(resource.progress));
    43	  };
    44	  resource.ready = (async () => {
    45	    let objectURL: string | undefined;
    46	    try {
    47	      // A corrupt HTTP 200 can survive in the browser cache after decode fails.
    48	      const response = await fetch(src, { priority, cache: failed.has(src) ? 'reload' : 'default' } as RequestInit);
    49	      if (!response.ok) throw new Error(`Image response ${response.status}`);
    50	      // Compressed transfers do not have a reliable decoded byte denominator.
    51	      const length = Number(response.headers.get('content-length'));
    52	      const total = !response.headers.get('content-encoding') && length > 0 ? length : null;
    53	      update({ total });
    54	      const chunks: Uint8Array<ArrayBuffer>[] = [];
    55	      const reader = response.body?.getReader();
    56	      if (reader) {
    57	        while (true) {
    58	          const { done, value } = await reader.read();
    59	          if (done) break;
    60	          chunks.push(new Uint8Array(value));
    61	          update({ loaded: resource.progress.loaded + value.byteLength });
    62	        }
    63	      } else {
    64	        chunks.push(new Uint8Array(await response.arrayBuffer()));
    65	        update({ loaded: chunks[0].byteLength });
    66	      }
    67	      if (total !== null && resource.progress.loaded !== total) throw new Error('Incomplete image transfer');
    68	      objectURL = URL.createObjectURL(new Blob(chunks, { type: response.headers.get('content-type') ?? 'application/octet-stream' }));
    69	      const image = new Image();
    70	      image.dataset.source = src;
    71	      image.src = objectURL;
    72	      await decodeImageElement(image);
    73	      failed.delete(src);
    74	      update({ ready: true });
    75	      return image;
    76	    } catch (error) {
    77	      if (objectURL) URL.revokeObjectURL(objectURL);
    78	      images.delete(src);
    79	      failed.add(src);
    80	      update({ error: true });
    81	      throw error;
    82	    }
    83	  })();
    84	  // Prefetch callers may choose to observe progress without awaiting readiness.
    85	  void resource.ready.catch(() => {});
    86	  images.set(src, resource);
    87	  return resource;
    88	}
