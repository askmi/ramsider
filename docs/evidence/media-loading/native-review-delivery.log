    20	export function LoadingStatus({ locale, progress = null, error = false, onRetry, className = '' }: {
    21	  locale: Locale; progress?: number | null; error?: boolean; onRetry?: () => void; className?: string;
    22	}) {
    23	  const value = progress === null ? null : Math.max(0, Math.min(100, Math.floor(progress)));
    24	  const [loading, failed, retry] = copy[locale];
    25	  return <div className={`media-loading ${className}`} role="status" aria-live="polite" dir={locale === 'ar' ? 'rtl' : undefined}>
    26	    <p>{error ? failed : loading}{!error && value !== null && <span aria-hidden="true"> {value}%</span>}</p>
    27	    {!error && <div className="media-loading__track" role="progressbar" aria-label={loading} aria-valuemin={0} aria-valuemax={100} {...(value !== null ? { 'aria-valuenow': value } : {})}>
    28	      <span className={value === null ? 'media-loading__bar is-indeterminate' : 'media-loading__bar'} style={value !== null ? { width: `${value}%` } : undefined} />
    29	    </div>}
    30	    {error && onRetry && <button type="button" onClick={onRetry}>{retry}</button>}
    31	  </div>;
    32	}
    33
    34	let locks = 0;
    35	let restore: (() => void) | undefined;
    36	/** Multiple media views can own a lock without prematurely unlocking each other. */
    37	export function useScrollLock(active: boolean) {
    38	  useEffect(() => {
    39	    if (!active) return;
    40	    if (locks++ === 0) {
    41	      const roots = [document.documentElement, document.body];
    42	      const previous = roots.map(element => ({ overflow: element.style.overflow, overscroll: element.style.overscrollBehavior, scrollBehavior: element.style.scrollBehavior }));
    43	      // Cancel a smooth anchor/opener scroll already in flight before freezing the view.
    44	      window.scrollTo({ left: scrollX, top: scrollY, behavior: 'instant' });
    45	      roots.forEach(element => { element.style.overflow = 'hidden'; element.style.overscrollBehavior = 'none'; element.style.scrollBehavior = 'auto'; });
    46	      const keydown = (event: KeyboardEvent) => {
    47	        if (document.querySelector('dialog[open]') || (event.target as Element)?.closest('button,input,textarea,select,a')) return;
    48	        if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'PageUp', 'PageDown', 'Home', 'End', ' '].includes(event.key)) event.preventDefault();
    49	      };
    50	      const preventScroll = (event: Event) => {
    51	        if ((event.target as Element)?.closest?.('dialog[open]')) return;
    52	        event.preventDefault();
    53	      };
    54	      document.addEventListener('keydown', keydown);
    55	      document.addEventListener('wheel', preventScroll, { passive: false });
    56	      document.addEventListener('touchmove', preventScroll, { passive: false });
    57	      restore = () => {
    58	        roots.forEach((element, index) => { element.style.overflow = previous[index].overflow; element.style.overscrollBehavior = previous[index].overscroll; element.style.scrollBehavior = previous[index].scrollBehavior; });
    59	        document.removeEventListener('keydown', keydown);
    60	        document.removeEventListener('wheel', preventScroll);
    61	        document.removeEventListener('touchmove', preventScroll);
    62	      };
    63	    }
    64	    return () => { if (--locks === 0) { restore?.(); restore = undefined; } };
    65	  }, [active]);
    66	}
