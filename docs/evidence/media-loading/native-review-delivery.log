     1	export type ImageProgress = { loaded: number; total: number | null; ready: boolean; error: boolean };
     2	export type ImageResource = {
     3	  ready: Promise<HTMLImageElement>;
     4	  progress: ImageProgress;
     5	  subscribe: (listener: (progress: ImageProgress) => void) => () => void;
     6	};
     7
     8	const images = new Map<string, ImageResource>();
     9	const decoded = new WeakMap<HTMLImageElement, Promise<void>>();
    10
    11	/** Readiness belongs to the actual element that will paint, including native lazy images. */
    12	export function decodeImageElement(image: HTMLImageElement): Promise<void> {
    13	  const existing = decoded.get(image);
    14	  if (existing) return existing;
    15	  const ready = image.decode().then(() => {
    16	    if (!image.naturalWidth) throw new Error('Image has no decoded pixels');
    17	  }).catch(error => {
    18	    decoded.delete(image);
    19	    throw error;
    20	  });
    21	  decoded.set(image, ready);
    22	  return ready;
    23	}
    24
    25	/** One original-byte transfer and one retained decoded image per URL, shared by all viewers. */
    26	export function loadImage(src: string, priority: 'low' | 'high' = 'low'): ImageResource {
    27	  const existing = images.get(src);
    28	  if (existing) return existing;
    29	  const listeners = new Set<(progress: ImageProgress) => void>();
    30	  const resource: ImageResource = {
    31	    progress: { loaded: 0, total: null, ready: false, error: false },
    32	    ready: Promise.resolve(null as unknown as HTMLImageElement),
    33	    subscribe(listener) {
    34	      listeners.add(listener);
    35	      listener(resource.progress);
    36	      return () => { listeners.delete(listener); };
    37	    },
    38	  };
    39	  const update = (patch: Partial<ImageProgress>) => {
    40	    resource.progress = { ...resource.progress, ...patch };
    41	    listeners.forEach(listener => listener(resource.progress));
    42	  };
    43	  resource.ready = (async () => {
    44	    let objectURL: string | undefined;
    45	    try {
    46	      const response = await fetch(src, { priority } as RequestInit);
    47	      if (!response.ok) throw new Error(`Image response ${response.status}`);
    48	      // Compressed transfers do not have a reliable decoded byte denominator.
    49	      const length = Number(response.headers.get('content-length'));
    50	      const total = !response.headers.get('content-encoding') && length > 0 ? length : null;
    51	      update({ total });
    52	      const chunks: Uint8Array<ArrayBuffer>[] = [];
    53	      const reader = response.body?.getReader();
    54	      if (reader) {
    55	        while (true) {
    56	          const { done, value } = await reader.read();
    57	          if (done) break;
    58	          chunks.push(new Uint8Array(value));
    59	          update({ loaded: resource.progress.loaded + value.byteLength });
    60	        }
    61	      } else {
    62	        chunks.push(new Uint8Array(await response.arrayBuffer()));
    63	        update({ loaded: chunks[0].byteLength });
    64	      }
    65	      if (total !== null && resource.progress.loaded !== total) throw new Error('Incomplete image transfer');
    66	      objectURL = URL.createObjectURL(new Blob(chunks, { type: response.headers.get('content-type') ?? 'application/octet-stream' }));
    67	      const image = new Image();
    68	      image.dataset.source = src;
    69	      image.src = objectURL;
    70	      await decodeImageElement(image);
    71	      update({ ready: true });
    72	      return image;
    73	    } catch (error) {
    74	      if (objectURL) URL.revokeObjectURL(objectURL);
    75	      images.delete(src);
    76	      update({ error: true });
    77	      throw error;
    78	    }
    79	  })();
    80	  // Prefetch callers may choose to observe progress without awaiting readiness.
    81	  void resource.ready.catch(() => {});
    82	  images.set(src, resource);
    83	  return resource;
    84	}
