-.technology-viewer__previous-group{position:absolute;left:max(2%,env(safe-area-inset-left));top:min(92.2%,calc(99% - 44px - env(safe-area-inset-bottom)));z-index:2;display:grid;place-items:center;width:44px;height:44px;padding:0;border:0;background:transparent;cursor:pointer}
+.technology-viewer__previous-group{position:absolute;left:max(2%,env(safe-area-inset-left));bottom:max(20px,env(safe-area-inset-bottom));z-index:2;display:grid;place-items:center;width:44px;height:44px;padding:0;border:0;background:transparent;cursor:pointer}
 .technology-viewer__previous-group img{width:20px;height:auto;transform:rotate(180deg)}
 .technology-viewer[data-group=CyberMind] .technology-viewer__next-group{left:max(15%,54px);right:15%;width:auto}
 .technology-viewer__sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
 .technology-viewer :focus-visible{outline:2px solid #e7ba75;outline-offset:-3px}
-/* Keep the full portrait artwork at one scale when browser chrome shortens the viewport. */
-@media(max-width:699px) and (orientation:portrait){.technology-viewer__canvas{width:min(100vw,calc(100dvh * .4667))}.technology-viewer__frame{left:0;width:100%}.technology-viewer__stage{left:3.08182784%;width:93.83634431%}}
-@media(min-width:700px){.technology-viewer__canvas{width:min(100vw,calc(100dvh * 954 / 1649))}}
+.technology-viewer button:disabled{cursor:default;opacity:.45}
+@media(min-width:700px) and (hover:hover){.technology-viewer__canvas{width:min(100vw,calc(100dvh * 954 / 1649))}}
+.page-media-shell,.page-media-content{display:contents}
+html:has(.page-media-shell[data-media-blocked]),body:has(.page-media-shell[data-media-blocked]){overflow:hidden}
+.dialog-controller:has(.page-media-shell[data-media-blocked])>.back-to-top{visibility:hidden}
+img[data-media]:not([data-media-ready]){visibility:hidden}
+.page-media-overlay{position:fixed;inset:0;z-index:900;display:grid;place-items:end center;padding:24px max(24px,env(safe-area-inset-right)) max(32px,env(safe-area-inset-bottom));background:#181512;color:#fff;touch-action:none}
+.page-media-overlay .media-loading{width:min(100%,420px)}
+.media-loading{font:400 14px/1.4 OpenSans,Arial,sans-serif;text-align:center}
+.media-loading p{margin:0 0 10px}
+.media-loading__track{height:4px;background:#d6d0c7;overflow:hidden;direction:ltr}
+.media-loading__bar{display:block;height:100%;background:#ac7e41}
+.media-loading__bar.is-indeterminate{width:35%;animation:media-progress 1.2s ease-in-out infinite}
+.media-loading button{margin-top:8px;min-height:44px;padding:8px 18px;border:1px solid #b38c53;background:#fff;color:#241d15;font:inherit;cursor:pointer}
+.media-loading button:focus-visible{outline:2px solid #8c5c25;outline-offset:3px}
+@keyframes media-progress{from{transform:translateX(-100%)}to{transform:translateX(385%)}}
+@media(prefers-reduced-motion:reduce){.media-loading__bar.is-indeterminate{animation:none;width:100%;opacity:.5}}
 .key-powered,.key-groupTag,.key-groupInvest{color:#bd945d}
 .key-group,.key-groupVision{color:#f3eee5}
 .key-account,.key-businessAccount,.key-accountBody,.key-venueAccount{color:#f1e1cb!important}
