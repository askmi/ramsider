     3	import { useEffect, useRef, useState, type ReactNode } from 'react';
     4	import type { Locale } from '@/lib/i18n';
     5	import { decodeImageElement } from '@/lib/media-resource';
     6	import { LoadingStatus, useScrollLock } from './MediaLoading';
     7
     8	function visible(image: HTMLImageElement) {
     9	  const box = image.getBoundingClientRect();
    10	  let top = Math.max(0, box.top), bottom = Math.min(innerHeight, box.bottom);
    11	  let left = Math.max(0, box.left), right = Math.min(innerWidth, box.right);
    12	  if (bottom <= top || right <= left) return false;
    13	  for (let parent = image.parentElement; parent; parent = parent.parentElement) {
    14	    const css = getComputedStyle(parent);
    15	    if (/(hidden|clip|scroll|auto)/.test(css.overflow + css.overflowY + css.overflowX)) {
    16	      const clip = parent.getBoundingClientRect();
    17	      top = Math.max(top, clip.top); bottom = Math.min(bottom, clip.bottom);
    18	      left = Math.max(left, clip.left); right = Math.min(right, clip.right);
    19	    }
    20	  }
    21	  return bottom > top && right > left;
    22	}
    23
    24	export function PageMediaGate({ locale, children }: { locale: Locale; children: ReactNode }) {
    25	  const root = useRef<HTMLDivElement>(null);
    26	  const retryAction = useRef<() => void>(() => {});
    27	  const [state, setState] = useState({ blocked: true, error: false });
    28	  useScrollLock(state.blocked);
    29	  useEffect(() => {
    30	    const images = [...root.current!.querySelectorAll<HTMLImageElement>('img[data-media]')];
    31	    const loading = new Set<HTMLImageElement>();
    32	    const failures = new Set<HTMLImageElement>();
    33	    let alive = true, frame = 0, retryVersion = Date.now();
    34	    const refresh = () => {
    35	      if (!alive) return;
    36	      const suspended = !!document.querySelector('dialog[open]');
    37	      const current = suspended ? [] : images.filter(visible);
    38	      const pending = current.filter(image => !image.hasAttribute('data-media-ready'));
    39	      const next = { blocked: pending.length > 0, error: pending.some(image => failures.has(image)) };
    40	      setState(previous => previous.blocked === next.blocked && previous.error === next.error ? previous : next);
    41	      pending.forEach(start);
    42	    };
    43	    const schedule = () => { cancelAnimationFrame(frame); frame = requestAnimationFrame(refresh); };
    44	    const start = (image: HTMLImageElement) => {
    45	      if (loading.has(image) || failures.has(image) || image.hasAttribute('data-media-ready')) return;
    46	      loading.add(image);
    47	      image.loading = 'eager';
    48	      void decodeImageElement(image).then(() => {
    49	        if (alive) image.setAttribute('data-media-ready', '');
    50	      }).catch(() => { if (alive) failures.add(image); }).finally(() => { loading.delete(image); schedule(); });
    51	    };
    52	    const observer = new IntersectionObserver(entries => {
    53	      if (!document.querySelector('dialog[open]')) entries.forEach(entry => { if (entry.isIntersecting) start(entry.target as HTMLImageElement); });
    54	      schedule();
    55	    }, { rootMargin: '75% 0px' });
    56	    images.forEach(image => observer.observe(image));
    57	    const dialogs = new MutationObserver(schedule);
    58	    document.querySelectorAll('dialog').forEach(dialog => dialogs.observe(dialog, { attributes: true, attributeFilter: ['open'] }));
    59	    retryAction.current = () => {
    60	      failures.forEach(image => {
    61	        failures.delete(image);
    62	        // Some browsers retain a corrupt HTTP 200 in their image cache.
    63	        // Retry the same original asset bytes through a fresh cache key.
    64	        const src = new URL(image.getAttribute('src')!, document.baseURI);
    65	        src.searchParams.set('media-retry', String(++retryVersion));
    66	        image.src = src.href;
    67	        start(image);
    68	      });
    69	      schedule();
    70	    };
    71	    addEventListener('scroll', schedule, { passive: true });
    72	    addEventListener('resize', schedule);
    73	    refresh();
    74	    return () => { alive = false; observer.disconnect(); dialogs.disconnect(); cancelAnimationFrame(frame); removeEventListener('scroll', schedule); removeEventListener('resize', schedule); };
    75	  }, []);
    76	  return <div ref={root} className="page-media-shell" data-media-blocked={state.blocked ? '' : undefined}>
    77	    <div className="page-media-content" inert={state.blocked}>{children}</div>
    78	    {state.blocked && <div className="page-media-overlay"><LoadingStatus locale={locale} error={state.error} onRetry={() => retryAction.current()} /></div>}
    79	  </div>;
    80	}

