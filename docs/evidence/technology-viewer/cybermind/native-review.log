const out = 'docs/evidence/technology-viewer/cybermind';
const crop = { left:16,top:80,width:576,height:256 };
const sources = { '01':'CyberMind_TOP_ONLY_941x1672.png', '02':'CyberMind_02_SYSTEM_CONNECTED_CLEAN_941x1672.png' };
