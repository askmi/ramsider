   394	test('metal contour reaches mobile side edges and the image stays inside its cutout', async ({ page }, testInfo) => {
   395	  await page.goto('/en');
   396	  await page.locator('[data-technology-open]').first().click();
   397	  const viewer = page.locator('#technology-viewer');
   398	  await viewer.locator('img').evaluateAll(async images => { await document.fonts.ready; await Promise.all(images.map(image => (image as HTMLImageElement).decode())); });
   399	  const canvas = await viewer.locator('.technology-viewer__canvas').boundingBox();
   400	  const frame = await viewer.locator('.technology-viewer__frame').boundingBox();
   401	  const stage = await viewer.locator('.technology-viewer__stage').boundingBox();
   402	  if (!canvas || !frame || !stage) throw new Error('Missing gallery geometry');
   403	  const viewportWidth = await page.evaluate(() => innerWidth);
   404	  expect(viewportWidth).toBe(testInfo.project.use.viewport?.width);
   405	  const fullWidth = viewportWidth < 700;
   406	  if (fullWidth) {
   407	    expect(frame.x).toBeCloseTo(canvas.x, 1);
   408	    expect(frame.width).toBeCloseTo(canvas.width, 1);
   409	    expect(frame.x).toBe(0);
   410	    expect(frame.width).toBe(viewportWidth);
   411	  }
   412	  expect(stage.x).toBeCloseTo(frame.x + frame.width * 29 / 941, 1);
   413	  expect(stage.width).toBeCloseTo(frame.width * 883 / 941, 1);
   414	  const screenshot = await page.screenshot();
   415	  const { data, info } = await sharp(screenshot).removeAlpha().raw().toBuffer({ resolveWithObject: true });
   416	  const scale = info.width / viewportWidth;
   417	  const y = Math.floor((frame.y + frame.height / 2) * scale);
   418	  // Both edge pixels must contain metal, not the formerly exterior black gutters.
   419	  for (const x of [Math.round(frame.x * scale), Math.round((frame.x + frame.width) * scale) - 1]) {
   420	    expect(Math.max(...data.subarray((y * info.width + x) * 3, (y * info.width + x) * 3 + 3))).toBeGreaterThan(10);
   421	  }
   422	});

