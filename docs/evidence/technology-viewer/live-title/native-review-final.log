.tail-art{position:absolute;inset:0;overflow:hidden;pointer-events:none}
.tail-art-track{position:absolute;inset:calc(-3007/941*100cqw) 0 auto}
.overlay{position:absolute;z-index:3;margin:0;line-height:1.16;font-weight:400;white-space:normal;color:#261d18;text-align:start}
.overlay span{white-space:nowrap}
.overlay.title{font-weight:400;letter-spacing:0;line-height:1.2}
.overlay.body{font-weight:300;color:#5d5149;line-height:1.22}
.overlay.key-choiceBody{color:#41342d}
.overlay.label{font-weight:400;letter-spacing:.08em;line-height:1.25}
.feature-divider-art,.technology-connector-art,.designer-icon{position:absolute;z-index:3;height:auto;pointer-events:none}
.expression-waves-art{position:absolute;z-index:2;height:auto;pointer-events:none}
html:not(:lang(en)) :is(.key-triple,.key-core,.key-touch,.key-water){left:calc(70/941*100cqw)!important;width:calc(230/941*100cqw)!important;font-size:calc(29/941*100cqw)!important}
html:not(:lang(en)) :is(.key-light,.key-armor,.key-flow){left:calc(645/941*100cqw)!important;width:calc(210/941*100cqw)!important;font-size:calc(29/941*100cqw)!important}
html:not(:lang(en)) :is(.key-triple,.key-core,.key-touch,.key-water,.key-light,.key-armor,.key-flow) span{white-space:normal}
.overlay.small{font-weight:400;letter-spacing:.12em;color:#8b6b4f}
.overlay.brand{font-family:BankGothic,OpenSans,sans-serif;letter-spacing:.18em}
.overlay.align-center{text-align:center}
.overlay.align-right{text-align:right}
/* Mapped surfaces use reference-calibrated source SVG geometry; hit areas stay 44px. */
.story-button{display:flex;align-items:center;justify-content:center;position:absolute;min-height:44px;padding:0;border:0;background:transparent;text-decoration:none;font-weight:400;line-height:1.15;isolation:isolate}
.button-pill{font-family:OpenSansButton,OpenSans,Arial,sans-serif;height:var(--surface-height);min-height:0;white-space:nowrap;color:#39332b}
      if (token === requestToken.current && dialog.current?.open) {
        displayedIndex.current = next;
        setIndex(next);
      }
    }).catch(() => {
      if (token === requestToken.current) requestedIndex.current = displayedIndex.current;
    });
  };
  const move = (delta: number) => showSlide(requestedIndex.current + delta);
  const onPointerDown = (event: PointerEvent<HTMLDivElement>) => {
    pointer.current = { x: event.clientX, y: event.clientY };
    try { event.currentTarget.setPointerCapture(event.pointerId); } catch { /* Synthetic test events do not own a pointer. */ }
  };
  const onPointerUp = (event: PointerEvent<HTMLDivElement>) => {
    const start = pointer.current;
    pointer.current = null;
    if (!start) return;
    const dx = event.clientX - start.x;
    const dy = event.clientY - start.y;
    if (dy > 65 && dy > Math.abs(dx) * 1.2) { setShowUnavailable(true); return; }
    if (Math.abs(dx) < 45 || Math.abs(dx) < Math.abs(dy) * 1.2) return;
    move((dx < 0 ? 1 : -1) * (locale === 'ar' ? -1 : 1));
  };

  return <dialog
    ref={dialog}
    id="technology-viewer"
    className="technology-viewer"
    aria-labelledby={isOpen ? 'technology-viewer-title' : undefined}
    aria-label={isOpen ? undefined : 'HeatCore'}
    aria-describedby="technology-viewer-instructions"
    tabIndex={-1}
    onClose={() => {
      requestToken.current++;
      setIsOpen(false);
      document.body.style.overflow = previousOverflow.current;
      opener.current?.focus();
    }}
    onKeyDown={event => {
      if (event.key === 'ArrowRight') { event.preventDefault(); move(locale === 'ar' ? -1 : 1); }
      if (event.key === 'ArrowLeft') { event.preventDefault(); move(locale === 'ar' ? 1 : -1); }
    }}
  >
    <div className="technology-viewer__canvas">
      <div className="technology-viewer__stage" onPointerDown={onPointerDown} onPointerUp={onPointerUp} onPointerCancel={() => { pointer.current = null; }}>
        {isOpen && <Image key={slides[index].src} src={slides[index].src} alt={`HeatCore — ${labels.names[index]}`} fill sizes="100vw" unoptimized priority={index === 0} draggable={false} />}
        {isOpen && <TechnologyTitle descriptor={labels.technology} />}
      </div>
      {isOpen && <>
        <Image className="technology-viewer__frame" src="/art/technology/frame-template.webp" width={941} height={1628} alt="" aria-hidden="true" unoptimized priority />
        <TechnologyNavigation direction="right" label={labels.details} accessibleLabel={labels.nextImage} onClick={() => showSlide(requestedIndex.current + 1)} />
        <TechnologyPagination index={index} labels={labels} onSelect={showSlide} />
        <TechnologyNavigation direction="down" label={labels.nextGroup} accessibleLabel={labels.nextGroup} onClick={() => setShowUnavailable(true)} />
      </>}
      {showUnavailable && <p className="technology-viewer__notice" role="status">{labels.unavailable}</p>}
      <button className="technology-viewer__close" type="button" onClick={close} aria-label={labels.close}>×</button>
    </div>
    <p id="technology-viewer-instructions" className="technology-viewer__sr-only">{labels.horizontal}. {labels.vertical}. {labels.image} {index + 1} / {slides.length}.</p>
  </dialog>;
}
