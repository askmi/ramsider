+.technology-viewer__loading{position:absolute;z-index:10;left:4%;right:4%;bottom:max(3%,env(safe-area-inset-bottom));padding:16px;background:rgb(255 255 255 / .96);color:#241d15;border:1px solid #ad8c5a}
 .technology-viewer__title{position:absolute;inset:0;margin:0;font-family:OpenSans,Arial,sans-serif;font-weight:400;line-height:1;direction:ltr;pointer-events:none}
 .technology-viewer__title svg{display:block;width:100%;height:100%;font-family:inherit;font-weight:inherit}
 .technology-viewer__descriptions{position:absolute;inset:0;pointer-events:none;font-family:OpenSans,Arial,sans-serif;font-weight:400;color:#000;direction:ltr}
 .technology-viewer__descriptions svg{display:block;width:100%;height:100%;font-family:inherit}
 .technology-description__box{width:100%;height:100%;font-family:OpenSans,Arial,sans-serif;text-align:start}
 .technology-description__copy{margin:0;font-family:inherit;font-weight:400;white-space:pre-line;overflow-wrap:break-word}
-.technology-description__warm,.technology-description__number{-webkit-text-stroke:1.5px #fff;paint-order:stroke fill}
-.technology-description__number{display:inline-block;width:40px;color:#975f41;direction:ltr}
+.technology-description__warm{-webkit-text-stroke:1.5px #fff;paint-order:stroke fill}
 .technology-description__status{color:#fff;font:400 10px/20px OpenSans,Arial,sans-serif;direction:ltr}
-.technology-viewer__frame{position:absolute;left:0;top:var(--frame-top);width:100%;height:var(--frame-height);pointer-events:none;border-style:solid;border-color:transparent;border-width:var(--metal-top) var(--metal-side) var(--metal-bottom);border-image:url('/art/technology/frame-template.webp') 31 29 28 29 stretch;border-image-width:var(--metal-top) var(--metal-side) var(--metal-bottom)}
-.technology-viewer__next-image,.technology-viewer__next-group{position:absolute;z-index:1;padding:0;border:0;background:transparent;color:#f4f1eb;font-family:OpenSans,Arial,sans-serif;font-weight:400;cursor:pointer}
-.technology-viewer__next-image{left:52px;right:max(52px,calc(44px + 2% + env(safe-area-inset-right)));top:env(safe-area-inset-top);height:44px;display:flex;align-items:flex-end;justify-content:center;gap:calc(17/954*100cqw);font-size:clamp(14px,calc(48/954*100cqw),26px);line-height:1.12}
+.technology-viewer__next-image{position:absolute;z-index:2;padding:0;border:0;background:transparent;color:#f4f1eb;font-family:OpenSans,Arial,sans-serif;font-weight:400;cursor:pointer;left:52px;right:max(52px,calc(44px + 2% + env(safe-area-inset-right)));top:env(safe-area-inset-top);height:44px;display:flex;align-items:center;justify-content:center;gap:calc(17/954*100cqw);font-size:clamp(14px,calc(48/954*100cqw),26px);line-height:1.12;direction:ltr}
 .technology-viewer__next-image span{max-width:calc(100% - 24px);text-align:center}
-.technology-viewer__next-image img{flex:none;align-self:flex-end;width:min(16px,calc(28/954*100cqw));height:auto}
-.technology-viewer__next-group{left:15%;bottom:env(safe-area-inset-bottom);width:70%;height:64px;min-height:44px;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;gap:calc(18/1649*100dvh);font-size:clamp(14px,calc(39/954*100cqw),23px);line-height:1.12}
-.technology-viewer__next-group img{flex:none;width:min(24px,calc(45/954*100cqw));height:auto}
-.technology-viewer__dots{position:absolute;z-index:2;top:calc(var(--frame-top) - 44px);left:50%;transform:translateX(-50%);display:flex;direction:ltr}
-.technology-viewer__dots button{position:relative;flex:0 0 24px;width:24px;height:44px;padding:0;border:0;background:transparent;cursor:pointer}
+.technology-viewer__next-image img{flex:none;width:min(16px,calc(28/954*100cqw));height:auto}
+.technology-viewer__next-image img.is-previous{transform:rotate(180deg)}
+.technology-viewer__dots{position:absolute;z-index:2;top:calc(44px + env(safe-area-inset-top));left:50%;transform:translateX(-50%);display:flex;direction:ltr}
+.technology-viewer__dots button{position:relative;flex:0 0 44px;width:44px;height:44px;padding:0;border:0;background:transparent;cursor:pointer}
 .technology-viewer__dots img{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);display:block;width:min(16px,calc(29/954*100cqw));height:auto}
-.technology-viewer__notice{position:absolute;z-index:3;left:10%;right:10%;bottom:11%;margin:0;padding:12px;border:1px solid #dcb477;background:rgb(0 0 0 / .9);color:#fff;text-align:center;font-size:14px;line-height:1.35}
-.technology-viewer__close{position:absolute;right:max(2%,env(safe-area-inset-right));top:max(1%,env(safe-area-inset-top));z-index:4;display:grid;place-items:center;width:44px;height:44px;padding:0;border:0;background:transparent;color:#fff;font-size:34px;font-weight:300;line-height:1;cursor:pointer}
-.technology-viewer__previous-group{position:absolute;left:max(2%,env(safe-area-inset-left));bottom:max(20px,env(safe-area-inset-bottom));z-index:2;display:grid;place-items:center;width:44px;height:44px;padding:0;border:0;background:transparent;cursor:pointer}
-.technology-viewer__previous-group img{width:20px;height:auto;transform:rotate(180deg)}
-.technology-viewer[data-group=CyberMind] .technology-viewer__next-group{left:max(15%,54px);right:15%;width:auto}
+.technology-viewer__close{position:absolute;right:max(2%,env(safe-area-inset-right));top:env(safe-area-inset-top);z-index:4;display:grid;place-items:center;width:44px;height:44px;padding:0;border:0;background:transparent;color:#fff;font-size:34px;font-weight:300;line-height:1;cursor:pointer}
 .technology-viewer__sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
 .technology-viewer :focus-visible{outline:2px solid #e7ba75;outline-offset:-3px}
 .technology-viewer button:disabled{cursor:default;opacity:.45}
