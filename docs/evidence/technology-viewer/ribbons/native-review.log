.project-hit:hover .project-arrow,.project-hit:focus-visible .project-arrow{filter:brightness(1.15)}
.project-number{position:absolute;z-index:5;margin:0;color:#9d8067;font-size:calc(16/941*100cqw);letter-spacing:.1em;text-transform:uppercase}
.project-active{position:absolute;z-index:5;display:grid;place-items:center;height:calc(32/941*100cqw);border:1px solid #bc8d51;border-radius:999px;color:#a2723e;font-size:max(10px,calc(14/941*100cqw));letter-spacing:.12em;text-transform:uppercase}
.overlay.key-step1,.overlay.key-step2,.overlay.key-step3{color:#30251d;font-weight:400}
.overlay.key-proInitial,.overlay.key-goldInitial,.overlay.key-proFinal,.overlay.key-goldFinal{color:#4f3e32;font-weight:400}
.key-project1Body,.key-project2Body,.key-project2More,.key-project3Body,.key-project4Body{letter-spacing:.02em!important}
.key-project1Body span:last-child{display:inline-block;margin-top:calc(15/941*100cqw)}
.key-projects{font-family:OpenSans,Arial,sans-serif!important;color:#bb854e;letter-spacing:.22em}
.availability{margin:0;position:fixed;inset:auto;top:50%;left:50%;transform:translate(-50%,-50%);width:min(440px,calc(100vw - 32px));max-height:calc(100dvh - 32px);overflow:auto;padding:28px;border:1px solid #a8753d;border-radius:16px;background:#f7f0e6;color:#292019;box-shadow:0 20px 80px #21140baa}
.availability::backdrop{background:#160d08a6}
.availability h2{font-size:23px;line-height:1.2;margin:0 0 14px}
.availability p{line-height:1.5;margin:0 0 24px}
.availability button{border:1px solid #9d713a;border-radius:999px;background:#2a251e;color:#fff;padding:10px 22px;min-height:44px}
.technology-viewer{position:fixed;inset:0;margin:0;width:100vw;max-width:none;height:100dvh;max-height:none;padding:0;border:0;background:#000;color:#fff;overflow:hidden;display:none;z-index:1000;overscroll-behavior:contain}
.technology-viewer[open]{display:flex;align-items:center;justify-content:center}
.technology-viewer::backdrop{background:#000}
/* Safari can sample document paint outside a modal's visual viewport. */
html:has(#technology-viewer[open]),body:has(#technology-viewer[open]){background:#000}
.dialog-controller:has(> #technology-viewer[open]) > :not(#technology-viewer),.dialog-controller:has(> #technology-viewer[open]) > :not(#technology-viewer) *{visibility:hidden}
/* Full-width proportional source planes; only empty photo edges overlap. */
.technology-viewer__canvas{--toolbar-height:calc(88px + env(safe-area-inset-top));--join:calc(48 / 941 * 100cqw);position:relative;width:100%;height:100%;container-type:inline-size}
