-.technology-viewer__dots button{position:relative;flex:0 0 24px;width:24px;height:44px;padding:0;border:0;background:transparent;cursor:pointer}
+.technology-viewer__next-image img{flex:none;width:min(16px,calc(28/954*100cqw));height:auto}
+.technology-viewer__next-image img.is-previous{transform:rotate(180deg)}
+.technology-viewer__dots{position:absolute;z-index:2;top:calc(44px + env(safe-area-inset-top));left:50%;transform:translateX(-50%);display:flex;direction:ltr}
+.technology-viewer__dots button{position:relative;flex:0 0 44px;width:44px;height:44px;padding:0;border:0;background:transparent;cursor:pointer}
 .technology-viewer__dots img{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);display:block;width:min(16px,calc(29/954*100cqw));height:auto}
