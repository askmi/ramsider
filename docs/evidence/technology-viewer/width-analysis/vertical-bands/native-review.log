-.technology-viewer__canvas{--frame-top:calc(88px + env(safe-area-inset-top));--frame-bottom:max(68px,calc(64px + env(safe-area-inset-bottom)));--frame-height:calc(100dvh - var(--frame-top) - var(--frame-bottom));--metal-side:calc(29 / 941 * 100cqw);--metal-top:calc(31 / 941 * 100cqw);--metal-bottom:calc(28 / 941 * 100cqw);position:relative;width:100%;height:100%;container-type:inline-size}
+/* Full-width 941:1672 photo inside a 941-wide frame with 29px side and 31/28px vertical borders. */
+.technology-viewer__canvas{--frame-base-top:calc(88px + env(safe-area-inset-top));--frame-bottom:max(68px,calc(64px + env(safe-area-inset-bottom)));--frame-space:calc(100dvh - var(--frame-base-top) - var(--frame-bottom));--frame-height:min(var(--frame-space),calc(100cqw * 1.7300145345));--frame-top:calc(var(--frame-base-top) + (var(--frame-space) - var(--frame-height)) / 2);--metal-side:calc(29 / 941 * 100cqw);--metal-top:calc(31 / 941 * 100cqw);--metal-bottom:calc(28 / 941 * 100cqw);position:relative;width:100%;height:100%;container-type:inline-size}
 .technology-viewer__stage{position:absolute;left:var(--metal-side);top:calc(var(--frame-top) + var(--metal-top));width:calc(100% - 2 * var(--metal-side));height:calc(var(--frame-height) - var(--metal-top) - var(--metal-bottom));overflow:hidden;touch-action:pan-y pinch-zoom;background:#fff;container-type:size}
 .technology-viewer__scroll{width:100%;height:100%;overflow-x:hidden;overflow-y:auto;overscroll-behavior:contain;display:flex;flex-direction:column;touch-action:pan-y pinch-zoom;scrollbar-width:none}
 .technology-viewer__scroll::-webkit-scrollbar{display:none}
