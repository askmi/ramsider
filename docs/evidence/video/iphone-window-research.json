  "verdict": "Architecture appropriate for controlled iPhone web viewport filling. Whole-device fullscreen, oldSafari and arbitrary WKWebView hosts are not guaranteed.",
  "sources": [
    {
      "title": "WebKit iOS inline policy",
      "url": "https://webkit.org/blog/6784/new-video-policies-for-ios/",
      "finding": "playsinline permits inline iPhone playback; host policies can differ; this is not permission to hide Safari chrome."
    },
    {
      "title": "WebKit Safari16.4 release",
      "url": "https://webkit.org/blog/13966/webkit-features-in-safari-16-4/",
      "finding": "Unprefixed fullscreen announced for macOS+iPadOS, not equivalent iPhone support; orientation locking was experimental then."
    },
    {
      "title": "WebKit current iPhone fullscreen master issue",
      "url": "https://bugs.webkit.org/show_bug.cgi?id=206854",
      "finding": "Master issue remains NEW on2026-10-31; recent duplicate328773 confirms continuing request, not tested behavior on every iOSversion."
    },
    {
      "title": "Apple native fullscreen API",
      "url": "https://developer.apple.com/documentation/webkitjs/htmlvideoelement",
      "finding": "Public video fullscreen entry/exit/state/presentation API has no exposed web fill/zoom setting; inference from API inventory, not a claim about native-app AVPlayer APIs."
    },
    {
      "title": "WebKit dynamic viewport units",
      "url": "https://webkit.org/blog/12445/new-webkit-features-in-safari-15-4/",
      "finding": "dvh/dvw shipped15.4, follow dynamic viewport rather than fixed phone dimensions."
    },
    {
      "title": "W3C CSS viewport units",
      "url": "https://www.w3.org/TR/css-values-4/#viewport-relative-lengths",
      "finding": "Dynamic UI animation need not update units continuously; some overlays including keyboard need not change units. Working Draft, not device test."
    },
    {
      "title": "WebKit safe areas",
      "url": "https://webkit.org/blog/7929/designing-websites-for-iphone-x/",
      "finding": "viewport-fit cover enables edge layout; env safe insets protect interactive content."
    },
    {
      "title": "W3C object-fit",
      "url": "https://www.w3.org/TR/css-images-3/#the-object-fit",
      "finding": "Cover preserves aspect with crop; contain preserves full content with possible empty space. Encoded matte remains source pixels."
    },
    {
      "title": "Apple WKWebView inline policy",
      "url": "https://developer.apple.com/documentation/webkit/wkwebviewconfiguration/allowsinlinemediaplayback",
      "finding": "Embedding app can allow inline or force native fullscreen; web page cannot override its host configuration."
    },
    {
      "title": "Apple WKWebView custom identity",
      "url": "https://developer.apple.com/documentation/webkit/wkwebview/customuseragent",
      "finding": "Embedding app can choose custom UA. Current iPhone-token routing is not a guarantee for arbitrary host identities."
    },
    {
      "title": "Next supported browser baseline",
      "url": "https://nextjs.org/docs/architecture/supported-browsers",
      "finding": "Safari16.4 default baseline; confirmed by installedNext16.2.11 modern-browserslist-target.js. Not proof of testing every supported version."
    },
    {
      "title": "WebKit Safari16 container queries",
      "url": "https://webkit.org/blog/13152/webkit-features-in-safari-16-0/",
      "finding": "Container queries and query units shippedSafari16.0; current player uses these existing site features."
    },
    {
      "title": "WebKit system-component fixed layout issue",
      "url": "https://bugs.webkit.org/show_bug.cgi?id=297779",
      "finding": "Status MOVED; engineer identified system-component bug; later reports mixed. Historical possible class, not diagnosis of customer or claim every current release broken."
    },
    {
      "title": "WebKit LiquidGlass gap issue",
      "url": "https://bugs.webkit.org/show_bug.cgi?id=297182",
      "finding": "Status FIXED with landedcommit; duplicate299003. Does not independently identify public iOS version used by customer."
    },
    {
      "title": "WebKit native pinch issue",
